<% layout("/layouts/boilerplate") %>
<body>
  <style>
    #filters{
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }
    .filter{
      text-align: center;
      margin-left: 2.2rem;
      margin-top:2rem;
      opacity: 0.8;
    }
    .filter div i{
      font-size:1.3rem;
    }
    .filter:hover{
      opacity: 1;
      cursor:pointer;
    }
    .gst{
      display: none;
    }
    #toggle{
      border:1px solid black;
      height:3.3rem;
      text-align: center;
      border-radius:1rem;
      padding:0.7rem;
      margin-left:5rem;
    }
  </style>
<div id="filters">
  <div class="filter">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
    <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-tent"></i></div>
    <p>Camping</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-house-chimney-crack"></i></div>
    <p>Village</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-building-wheat"></i></div>
    <p>Farms</p>
  </div>
  <div id="toggle">
  <div class="form-check-reverse form-switch ">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Desplay total after Taxes</label>
  </div>
  </div>
</div>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1" style="margin-top:2rem !important;">
  <%for(let listing of alllisting){%>
  <a href="/listings/<%=listing._id%>" class="listing-link">
  <div class="card listing-card ">
    <img src="<%=listing.image.url%>" class="card-img-top" alt="Listing_images" style="height:20rem;">
  <div class="card-body">
    <p class="card-text"><b><%=listing.title%></b><br/>&#8377; <%=listing.price.toLocaleString("en-IN") %> <i class="gst">&nbsp;&nbsp;&nbsp;18+GST</i></p>
  </div>
  </div>
  </a>
   <%}%>
</div>
<script>
  let taxSwitc=document.getElementById("switchCheckDefault");
  taxSwitc.addEventListener("click",()=>{
    let gst=document.getElementsByClassName("gst");
    for(texGst of gst){
      if(texGst.style.display!="inline"){
      texGst.style.display="inline";
      }else{
        texGst.style.display="none";
      }
    }
  })
</script>
</body>

