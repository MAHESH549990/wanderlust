
<% layout("/layouts/boilerplate") %>
<div class="container mt-4">
  <div class="col-12 col-md-10 col-lg-8">
    <h1><b><%=listing.title%></b></h1>
  </div>
<div class="row">
  <img src="<%=listing.image.url%>"  class="card-img-top show-img" alt="Listing_image" style="width:60rem !important; height:30rem !important; border-radius: 1rem !important;">
    <div class="card-body">
        <p>Owned By: <%=listing.owner.username%></p>
        <hr>
        <%=listing.description%><br/>
        ₹ <%= listing.price.toLocaleString("en-IN") %><br/>
        <%= listing.location %><br/>
        <%= listing.country %>
    </p>
    </div>
</div>


<%if(currUser && listing.owner._id.equals(currUser._id)){%>
<div class="row mt-3">
    <div class="col-auto">
        <a href="/listings/<%= listing._id %>/edit"
           class="btn edit-btn">
            Edit
        </a>
    </div>

    <div class="col-auto">
        <form method="POST"
              action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn delete-btn">
                Delete
            </button>
        </form>
    </div>
</div>
<%}%>

</div>
<hr class="mt-3">
<div class="row justify-content-center">
  <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
     <%if(currUser){%>
      <h1>Leave Review</h1>
      <div>
      <label for="rating" class="form-label fs-5">Rating: </label>
      <fieldset class="starability-slot">
      <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
      <input type="radio" id="first-rate1" name="review[rating]" value="1" />
      <label for="first-rate1" title="Terrible">1 star</label>
      <input type="radio" id="first-rate2" name="review[rating]" value="2" />
      <label for="first-rate2" title="Not good">2 stars</label>
      <input type="radio" id="first-rate3" name="review[rating]" value="3" />
      <label for="first-rate3" title="Average">3 stars</label>
      <input type="radio" id="first-rate4" name="review[rating]" value="4" />
      <label for="first-rate4" title="Very good">4 stars</label>
      <input type="radio" id="first-rate5" name="review[rating]" value="5" />
      <label for="first-rate5" title="Amazing">5 stars</label>
    </fieldset>
    </div>
      <div>
        <label class="form-label fs-5" for="comment">Comment: </label>
        <textarea type="text" name="review[comment]" class="form-control" id="comment" rows="6" required></textarea>
        <div class="invalid-feedback">Need comment for feedback</div>
      </div>
      <button class="btn btn-outline-dark mt-4">Submit</button>
      <%}%>
  </form>
  <hr class="mt-4">
 <h3><b>All Reviews</b></h3>
  <div class="row">
  <% for(let review of listing.reviews){ %>

    <div class="col-12 col-md-6 col-lg-5 mb-4">
      <div class="card h-100 p-3">
        <div class="card-body">

          <h5 class="card-title">@<%= review.author.username %></h5>

          <p class="starability-result"
             data-rating="<%= review.rating %>">
          </p>

          <p class="card-text"><%= review.comment %></p>
          <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this review?');">
            <%if(currUser){%>
            <button class="btn btn-outline-danger mt-3">Delete</button>
            <%}%>
          </form>

        </div>
      </div>
    </div>

  <% } %>
    <h3>Where you'll be</h3>
  <div id="map"></div>
</div>
<div>
</div>
</div>
<br/><br/>
<script>
    const mapToken = "<%= mapToken %>";
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
</script>

<script src="/js/map.js"></script>
