<% if(typeof success !== "undefined" && success.length){ %>
<div class="alert alert-success alert-dismissible fade show col-6 offset-4" role="alert">

<button 
type="button" 
class="btn-close" 
data-bs-dismiss="alert">
</button>

<p><%= success %></p>

</div>
<% } %>


<% if(typeof error !== "undefined" && error.length){ %>
<div class="alert alert-danger alert-dismissible fade show col-6 offset-4" role="alert">

<button 
type="button" 
class="btn-close" 
data-bs-dismiss="alert">
</button>

<p><%= error %></p>

</div>
<% } %>